:"round(b * c / min(a, b) / 32) * 32"}},{"id":122,"type":"ComfyMathExpression","pos":[500,866],"size":[400,200],"flags":{},"order":27,"mode":0,"inputs":[{"label":"a","localized_name":"values.a","name":"values.a","type":"FLOAT,INT,BOOLEAN","link":115},{"label":"b","localized_name":"values.b","name":"values.b","shape":7,"type":"FLOAT,INT,BOOLEAN","link":116},{"label":"c","localized_name":"values.c","name":"values.c","shape":7,"type":"FLOAT,INT,BOOLEAN","link":117},{"label":"d","localized_name":"values.d","name":"values.d","shape":7,"type":"FLOAT,INT,BOOLEAN","link":null},{"localized_name":"expression","name":"expression","type":"STRING","widget":{"name":"expression"},"link":null}],"outputs":[{"localized_name":"FLOAT","name":"FLOAT","type":"FLOAT","links":null},{"localized_name":"INT","name":"INT","type":"INT","links":[94]},{"localized_name":"BOOL","name":"BOOL","type":"BOOLEAN","links":null}],"title":"output width (exact)","properties":{"Node name for S&R":"ComfyMathExpression"},"widgets_values":["round(a * c / min(a, b) / 2) * 2"],"widgets_values_named":{"expression":"round(a * c / min(a, b) / 2) * 2"}},{"id":123,"type":"ComfyMathExpression","pos":[500,1116],"size":[400,200],"flags":{},"order":28,"mode":0,"inputs":[{"label":"a","localized_name":"values.a","name":"values.a","type":"FLOAT,INT,BOOLEAN","link":118},{"label":"b","localized_name":"values.b","name":"values.b","shape":7,"type":"FLOAT,INT,BOOLEAN","link":119},{"label":"c","localized_name":"values.c","name":"values.c","shape":7,"type":"FLOAT,INT,BOOLEAN","link":120},{"label":"d","localized_name":"values.d","name":"values.d","shape":7,"type":"FLOAT,INT,BOOLEAN","link":null},{"localized_name":"expression","name":"expression","type":"STRING","widget":{"name":"expression"},"link":null}],"outputs":[{"localized_name":"FLOAT","name":"FLOAT","type":"FLOAT","links":null},{"localized_name":"INT","name":"INT","type":"INT","links":[95]},{"localized_name":"BOOL","name":"BOOL","type":"BOOLEAN","links":null}],"title":"output height (exact)","properties":{"Node name for S&R":"ComfyMathExpression"},"widgets_values":["round(b * c / min(a, b) / 2) * 2"],"widgets_values_named":{"expression":"round(b * c / min(a, b) / 2) * 2"}},{"id":131,"type":"MarkdownNote","pos":[-620,0],"size":[560,900],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["# ai_influencer (quality setup)\n\n**Defaults**: full model (TURBO off), 40 steps, 768p (H3's native size), 10 s, seed fixed. 10 s ≈ 30 min on the 5090.\n\n**Your image** is upscaled with SeedVR2 and used as the first frame. For talking scenes, crop the image so faces are large (e.g. a tight 16:9 two-shot). Bigger faces = better lip sync.\n\n**Voice track (optional)**: turn on USE VOICE TRACK and pick an audio or video file with the dialogue. The mouths then follow that audio. Tip: render once, pick the take whose voices you like, drop that MP4 into ComfyUI/input and use it as the voice track for the next render.\n\n**Dialogue prompt tips**\n- Start with `<Picture 1>`, name each speaker by something visible (e.g. \"the man in the blue plaid shirt\").\n- Use a timeline: [0s-4.5s] who speaks + the line in quotes; [4.5s-10s] the next speaker.\n- Say what the listener does: \"stays silent with his lips closed, nodding\".\n- Add \"realistic lip articulation, no exaggerated mouth opening\".\n- Keep each line short enough for its time slot.\n\nBackup of the previous ai_influencer: **ai_influencer_backup.json**."],"widgets_values_named":{"text":"# ai_influencer (quality setup)\n\n**Defaults**: full model (TURBO off), 40 steps, 768p (H3's native size), 10 s, seed fixed. 10 s ≈ 30 min on the 5090.\n\n**Your image** is upscaled with SeedVR2 and used as the first frame. For talking scenes, crop the image so faces are large (e.g. a tight 16:9 two-shot). Bigger faces = better lip sync.\n\n**Voice track (optional)**: turn on USE VOICE TRACK and pick an audio or video file with the dialogue. The mouths then follow that audio. Tip: render once, pick the take whose voices you like, drop that MP4 into ComfyUI/input and use it as the voice track for the next render.\n\n**Dialogue prompt tips**\n- Start with `<Picture 1>`, name each speaker by something visible (e.g. \"the man in the blue plaid shirt\").\n- Use a timeline: [0s-4.5s] who speaks + the line in quotes; [4.5s-10s] the next speaker.\n- Say what the listener does: \"stays silent with his lips closed, nodding\".\n- Add \"realistic lip articulation, no exaggerated mouth opening\".\n- Keep each line short enough for its time slot.\n\nBackup of the previous ai_influencer: **ai_influencer_backup.json**."},"color":"#432","bgcolor":"#653"},{"id":100,"type":"PrimitiveStringMultiline","pos":[-1.7385532617947288,-10.431319570768373],"size":[440,320],"flags":{},"order":14,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":[72]}],"title":"VIDEO PROMPT - refer to your image as <Picture 1>","properties":{"Node name for S&R":"PrimitiveStringMultiline"},"widgets_values":["<Picture 1> A real podcast recording in a soundproof studio, exactly as in Picture 1. On the left: the man in the blue plaid shirt with short brown hair. On the right: the man in the beige jacket with curly black hair. Both wear black headphones and sit in black leather chairs at black boom microphones. Steady medium two-shot, locked-off camera, no cuts, no zoom.\n\nTimeline:\n[0s-4.5s] The man in the blue plaid shirt turns toward the man in the beige jacket and says into his microphone, in a relaxed friendly voice: \"So, what do you think is the biggest change AI is going to bring to creative work?\" He lifts one hand slightly while talking. The man in the beige jacket stays silent with his lips closed, watching him and nodding once.\n[4.5s-10s] The man in the beige jacket answers into his microphone, in a calm thoughtful voice: \"I think the biggest change is that people will spend less time on repetitive tasks and more time actually developing their ideas.\" He gestures gently with one hand, then smiles briefly. The man in the blue plaid shirt stays silent with his lips closed, listening and nodding slowly.\n\nAudio: two distinct male voices, close-mic podcast sound in a quiet treated room, no music, no background noise.\n\nRealistic lip articulation, no exaggerated mouth opening, mouth shapes match every word, only the man who is speaking moves his lips. Smooth natural body motion, natural blinking and breathing. Preserve both faces, hairstyles, clothing, headphones, microphones, chairs, studio and lighting from Picture 1. No extra people, no text on screen, no subtitles.\n"],"widgets_values_named":{"value":"<Picture 1> A real podcast recording in a soundproof studio, exactly as in Picture 1. On the left: the man in the blue plaid shirt with short brown hair. On the right: the man in the beige jacket with curly black hair. Both wear black headphones and sit in black leather chairs at black boom microphones. Steady medium two-shot, locked-off camera, no cuts, no zoom.\n\nTimeline:\n[0s-4.5s] The man in the blue plaid shirt turns toward the man in the beige jacket and says into his microphone, in a relaxed friendly voice: \"So, what do you think is the biggest change AI is going to bring to creative work?\" He lifts one hand slightly while talking. The man in the beige jacket stays silent with his lips closed, watching him and nodding once.\n[4.5s-10s] The man in the beige jacket answers into his microphone, in a calm thoughtful voice: \"I think the biggest change is that people will spend less time on repetitive tasks and more time actually developing their ideas.\" He gestures gently with one hand, then smiles briefly. The man in the blue plaid shirt stays silent with his lips closed, listening and nodding slowly.\n\nAudio: two distinct male voices, close-mic podcast sound in a quiet treated room, no music, no background noise.\n\nRealistic lip articulation, no exaggerated mouth opening, mouth shapes match every word, only the man who is speaking moves his lips. Smooth natural body motion, natural blinking and breathing. Preserve both faces, hairstyles, clothing, headphones, microphones, chairs, studio and lighting from Picture 1. No extra people, no text on screen, no subtitles.\n"}},{"id":1,"type":"LoadImage","pos":[29.555405450510385,356.0915739056419],"size":[290.4166015625,314],"flags":{},"order":16,"mode":0,"inputs":[{"localized_name":"image","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"choose file to upload","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[96,108]},{"localized_name":"MASK","name":"MASK","type":"MASK","links":null}],"title":"YOUR IMAGE (used as the first frame)","properties":{"Node name for S&R":"LoadImage"},"widgets_values":["podcast_ref_16x9.jpg","image"],"widgets_values_named":{"image":"podcast_ref_16x9.jpg","upload":"image"}},{"id":70,"type":"LoadAudio","pos":[1.7385532617947288,1504.5215425310048],"size":[382.6470703125,136],"flags":{},"order":9,"mode":0,"inputs":[{"localized_name":"audio","name":"audio","type":"COMBO","widget":{"name":"audio"},"link":null},{"localized_name":"audioUI","name":"audioUI","type":"AUDIO_UI","widget":{"name":"audioUI"},"link":null},{"localized_name":"choose file to upload","name":"upload","type":"AUDIOUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"AUDIO","name":"AUDIO","type":"AUDIO","links":[103]}],"title":"VOICE TRACK (audio or video file with the dialogue)","properties":{"Node name for S&R":"LoadAudio"},"widgets_values":["podcast_voice_take1.mp4",null,null],"widgets_values_named":{"audio":"podcast_voice_take1.mp4","upload":null}},{"id":130,"type":"PrimitiveBoolean","pos":[5.215659785384187,1386.0902229602368],"size":[411.884375,5