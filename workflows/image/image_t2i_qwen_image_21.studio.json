{
  "title": "Text to Image: Qwen Image 2.1",
  "description": "Qwen Image 2.1 text-to-image (Qwen Research License (no monetized use)). Native 2K. Research license: not for monetized content.",
  "output_name": "9.filename_prefix",
  "labels": {},
  "required_refs": [],
  "optional_refs": [],
  "controls": [
    {
      "node": "37",
      "input": "aspect_ratio",
      "type": "choice",
      "choices": [
        "1:1",
        "16:9",
        "9:16",
        "4:3"
      ],
      "label": "Aspect ratio",
      "primary": true
    }
  ],
  "options": [
    {
      "id": "quality",
      "label": "Quality",
      "default": "draft",
      "choices": [
        {
          "id": "draft",
          "label": "Draft",
          "hint": "fewer steps, fast upscale"
        },
        {
          "id": "final",
          "label": "Final",
          "hint": "full steps + SeedVR2 upscale"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": {
        "quality": "draft"
      },
      "set": {
        "506.steps": 25,
        "45.switch": false
      }
    },
    {
      "when": {
        "quality": "final"
      },
      "set": {
        "506.steps": 40,
        "45.switch": true
      }
    }
  ],
  "hide": [
    "38",
    "39",
    "40",
    "41",
    "42",
    "43",
    "44",
    "45",
    "47",
    "500",
    "501",
    "502",
    "503",
    "504",
    "505",
    "506",
    "507",
    "107"
  ],
  "pricing": {},
  "hints": [
    "Native 2K. Research license: not for monetized content.",
    "Sizes: 1:1 1536x1536, 16:9 2752x1536, 9:16 1536x2752, 4:3 2048x1536 (rendered at the model's native size, then upscaled).",
    "References 0-16, all optional. Call them <image1>, <image2> ... in the prompt and say what to keep from each (face, outfit, product, style, place)."
  ],
  "seed": {
    "targets": [
      [
        "106",
        "value"
      ]
    ],
    "mode": "random",
    "min": 0,
    "max": 4294967295
  },
  "refs": {
    "mode": "dynamic",
    "min": 0,
    "max": 16,
    "node_class": "LoadImage",
    "node_input": "image",
    "node_id": "ref_{n}",
    "target_node": "501",
    "target_input": "images.image_{i}",
    "first_index": 1,
    "label": "REFERENCE {n} (character, product, outfit, style or location)",
    "prompt_tag": "<image{n}>"
  }
}