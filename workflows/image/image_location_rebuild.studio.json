{
  "title": "Location Rebuild",
  "description": "A rough, drawn or AI location image rebuilt as a real, empty photo of the same place: same layout, same camera (Qwen Image Edit 2511).",
  "output_name": "9.filename_prefix",
  "labels": {
    "20:image": "Location image (rough, drawn or AI)"
  },
  "required_refs": [
    "20:image"
  ],
  "optional_refs": [],
  "controls": [
    {
      "node": "37",
      "input": "aspect_ratio",
      "type": "choice",
      "choices": [
        "1:1",
        "16:9",
        "9:16",
        "4:3"
      ],
      "label": "Aspect ratio",
      "primary": true
    }
  ],
  "options": [
    {
      "id": "quality",
      "label": "Quality",
      "default": "draft",
      "choices": [
        {
          "id": "draft",
          "label": "Draft",
          "hint": "4 steps, about 10 s"
        },
        {
          "id": "final",
          "label": "Final",
          "hint": "40 steps + SeedVR2 upscale, about 2.5 min"
        }
      ]
    }
  ],
  "rules": [
    {
      "when": {
        "quality": "draft"
      },
      "set": {
        "15.steps": 4,
        "15.cfg": 1.0,
        "6.strength_model": 1.0,
        "45.switch": false
      }
    },
    {
      "when": {
        "quality": "final"
      },
      "set": {
        "15.steps": 40,
        "15.cfg": 4.0,
        "6.strength_model": 0.0,
        "45.switch": true
      }
    }
  ],
  "hide": [
    "1",
    "2",
    "3",
    "4",
    "5",
    "6",
    "10",
    "12",
    "13",
    "14",
    "15",
    "16",
    "40",
    "41",
    "42",
    "43",
    "44",
    "45",
    "47",
    "101",
    "102"
  ],
  "pricing": {},
  "hints": [
    "The rebuild instruction is built in. Use PROMPT only for extra notes, e.g. 'the floor is dark oak, it is evening'.",
    "Pick the aspect ratio closest to the input image; a matching ratio keeps the layout pixel-aligned."
  ],
  "prompt_optional": true
}
