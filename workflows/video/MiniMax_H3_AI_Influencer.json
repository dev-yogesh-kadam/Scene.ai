e name for S&R":"ImageUpscaleWithModel","cnr_id":"comfy-core","ver":"0.33.0"},"color":"#323","bgcolor":"#535"},{"id":43,"type":"ImageScale","pos":[3350,610],"size":[320,130],"flags":{},"order":44,"mode":0,"inputs":[{"localized_name":"image","name":"image","type":"IMAGE","link":58},{"localized_name":"upscale_method","name":"upscale_method","type":"COMBO","widget":{"name":"upscale_method"},"link":null},{"localized_name":"width","name":"width","type":"INT","widget":{"name":"width"},"link":59},{"localized_name":"height","name":"height","type":"INT","widget":{"name":"height"},"link":60},{"localized_name":"crop","name":"crop","type":"COMBO","widget":{"name":"crop"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[62]}],"title":"fit to OUTPUT size (lanczos)","properties":{"Node name for S&R":"ImageScale","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":["lanczos",3840,2160,"disabled"],"widgets_values_named":{"upscale_method":"lanczos","width":3840,"height":2160,"crop":"disabled"},"color":"#323","bgcolor":"#535"},{"id":44,"type":"ComfySwitchNode","pos":[3750,400],"size":[300,90],"flags":{},"order":45,"mode":0,"inputs":[{"localized_name":"on_false","name":"on_false","type":"IMAGE","link":61},{"localized_name":"on_true","name":"on_true","type":"IMAGE","link":62},{"localized_name":"switch","name":"switch","type":"BOOLEAN","widget":{"name":"switch"},"link":63}],"outputs":[{"localized_name":"output","name":"output","type":"IMAGE","links":[64]}],"title":"upscale switch","properties":{"Node name for S&R":"ComfySwitchNode","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":[true],"widgets_values_named":{"switch":true}},{"id":45,"type":"CreateVideo","pos":[3750,550],"size":[300,126],"flags":{},"order":46,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":64},{"localized_name":"audio","name":"audio","shape":7,"type":"AUDIO","link":65},{"localized_name":"fps","name":"fps","type":"FLOAT","widget":{"name":"fps"},"link":null},{"localized_name":"bit_depth","name":"bit_depth","shape":7,"type":"COMBO","widget":{"name":"bit_depth"},"link":null},{"localized_name":"color_space","name":"color_space","shape":7,"type":"COMBO","widget":{"name":"color_space"},"link":null}],"outputs":[{"localized_name":"VIDEO","name":"VIDEO","type":"VIDEO","links":[66]}],"title":"mux 24fps + stereo audio","properties":{"Node name for S&R":"CreateVideo","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":[24,8,"sRGB"],"widgets_values_named":{"fps":24,"bit_depth":8,"color_space":"sRGB"}},{"id":46,"type":"SaveVideo","pos":[4100,400],"size":[600,375.125],"flags":{},"order":47,"mode":0,"inputs":[{"localized_name":"video","name":"video","type":"VIDEO","link":66},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"format","name":"format","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"format"},"link":null},{"localized_name":"format.codec","name":"format.codec","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"format.codec"},"link":null},{"localized_name":"format.codec.encoding","name":"format.codec.encoding","shape":7,"type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"format.codec.encoding"},"link":null},{"localized_name":"codec","name":"codec","shape":7,"type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"codec"},"link":null}],"outputs":[{"localized_name":"video","name":"video","type":"VIDEO","links":null}],"title":"SAVE","properties":{"cnr_id":"comfy-core","ver":"0.33.0","Node name for S&R":"SaveVideo"},"widgets_values":["video/AI_Influencer_H3","mp4","h264","auto","auto"],"widgets_values_named":{"filename_prefix":"video/AI_Influencer_H3","format":"mp4","format.codec":"h264","format.codec.encoding":"auto","codec":"auto"}},{"id":47,"type":"MarkdownNote","pos":[-560,0],"size":[540,760],"flags":{},"order":13,"mode":0,"inputs":[],"outputs":[],"title":"README","properties":{"cnr_id":"comfy-core","ver":"0.33.0","Node name for S&R":"MarkdownNote"},"widgets_values":["# MiniMax H3 — AI Influencer Reference-to-Video Workflow\n\nThis version is optimized for **character + location consistency** rather than generic I2V.\n\n## Recommended reference setup\n1. **Picture 1 — Character primary:** clean front/hero portrait. Face clearly visible, neutral expression, good lighting.\n2. **Picture 2 — Character secondary:** 3/4 or alternate angle of the SAME person. Keep hair, makeup, outfit and age consistent.\n3. **Picture 3 — Location primary:** wide shot showing the environment you want.\n4. **Picture 4 — Location detail:** another angle/detail with the same lighting/time/place.\n5. **Picture 5 — Optional:** outfit/accessory/style detail OR another environment reference. Leave bypassed if unnecessary.\n\n## Prompt strategy\nKeep the references stable. Change only:\n- scene action\n- camera movement\n- framing\n- dialogue/expression\n- time/weather ONLY when you intentionally want a change\n\nDo not ask the model to redesign the character. The references establish identity; the prompt controls motion.\n\n## AI influencer workflow\n**Step 1 — Build the identity:** create a small library of high-quality character reference images for the same person.\n**Step 2 — Build locations:** create 2–4 consistent references per recurring location.\n**Step 3 — Generate short clips:** start with 5–6 seconds and conservative motion.\n**Step 4 — Keep the seed fixed** while testing a scene. Change the seed only when you need a new variation.\n**Step 5 — Stitch clips in editing software** rather than forcing one long generation to contain many actions.\n\n## Quality defaults\n- R2V mode: ON\n- R2V ref_image_size: max\n- Scheduler: beta\n- Steps: 30\n- Seed: fixed\n- Output baseline: 2560×1440\n- Upscale: ON\n\n## Important limitation\nThis workflow **does not fine-tune/train the H3 model**. It improves reference conditioning, prompt structure, defaults and repeatability. For stronger identity persistence across many outfits, poses and locations, the next level is a dedicated character-identity generation stage (and, if needed, a trained identity adapter/LoRA using a compatible image model) before H3 video generation.\n\n## H3 reference tags\nIn R2V mode use `<Picture 1>` through `<Picture 5>` when you need to explicitly refer to a reference. Keep the mapping above consistent across your project.\n"],"widgets_values_named":{"text":"# MiniMax H3 — AI Influencer Reference-to-Video Workflow\n\nThis version is optimized for **character + location consistency** rather than generic I2V.\n\n## Recommended reference setup\n1. **Picture 1 — Character primary:** clean front/hero portrait. Face clearly visible, neutral expression, good lighting.\n2. **Picture 2 — Character secondary:** 3/4 or alternate angle of the SAME person. Keep hair, makeup, outfit and age consistent.\n3. **Picture 3 — Location primary:** wide shot showing the environment you want.\n4. **Picture 4 — Location detail:** another angle/detail with the same lighting/time/place.\n5. **Picture 5 — Optional:** outfit/accessory/style detail OR another environment reference. Leave bypassed if unnecessary.\n\n## Prompt strategy\nKeep the references stable. Change only:\n- scene action\n- camera movement\n- framing\n- dialogue/expression\n- time/weather ONLY when you intentionally want a change\n\nDo not ask the model to redesign the character. The references establish identity; the prompt controls motion.\n\n## AI influencer workflow\n**Step 1 — Build the identity:** create a small library of high-quality character reference images for the same person.\n**Step 2 — Build locations:** create 2–4 consistent references per recurring location.\n**Step 3 — Generate short clips:** start with 5–6 seconds and conservative motion.\n**Step 4 — Keep the seed fixed** while testing a scene. Change the seed only when you need a new variation.\n**Step 5 — Stitch clips in editing software** rather than forcing one long generation to contain many actions.\n\n## Quality defaults\n- R2V mode: ON\n- R2V ref_image_size: max\n- Scheduler: beta\n- Steps: 30\n- Seed: fixed\n- Output baseline: 2560×1440\n- Upscale: ON\n\n## Important limitation\nThis workflow **does not fine-tune/train the H3 model**. It improves reference conditioning, prompt structure, defaults and repeatability. For stronger identity persistence across many outfits, poses and locations, the next level is a dedicated character-identity generation stage (and, if needed, a trained identity adapter/LoRA using a compatible image model) before H3 video generation.\n\n## H3 reference tags\nIn R2V mode use `<Picture 1>` through `<Picture 5>` when you need to explicitly refer to a reference. Keep the mapping above consistent across your project.\n"},"color":"#432","bgcolor":"#653"},{"id":2,"type":"PrimitiveFloat","pos":[6.724552197877239,213.3542669399786],"size":[392.4634765625,60],"flags":{},"order":20,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"FLOAT","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"FLOAT","name":"FLOAT","type":"FLOAT","links":[1]}],"title":"CLIP DURATION — start at 5–6 s for best consistency","properties":{"Node name for S&R":"PrimitiveFloat","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":[10],"widgets_values_named":{"value":10},"color":"#232","bgcolor":"#353"},{"id":3,"type":"PrimitiveInt","pos":[41.46807188690965,329.13171703184145],"size":[300,82],"flags":{},"order":21,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"INT","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"INT","name":"INT","type":"INT","links":[2,4,59]}],"title":"OUTPUT WIDTH (1920 / 2560 / 3840)","properties":{"Node name for S&R":"PrimitiveInt","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":[2560,"fixed"],"widgets_values_named":{"value":2560,"fixed":"fixed"},"color":"#232","bgcolor":"#353"},{"id":4,"type":"PrimitiveInt","pos":[51.55490018372546,451.633719321