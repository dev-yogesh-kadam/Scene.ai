{
  "title": "H3 Director",
  "description": "Reference-to-video with 11 optional reference slots. Saved at high quality (CRF 16).",
  "hide": ["108", "109", "105", "113"],
  "controls": [
    {"node": "6", "input": "describe_references", "type": "bool", "label": "Describe the references in the prompt"},
    {"node": "6", "input": "ref_image_size", "type": "choice", "choices": ["match", "max"], "label": "Reference image size (max = stronger identity, slower)"}
  ],
  "options": [
    {
      "id": "mode", "label": "Mode", "default": "fast",
      "choices": [
        {"id": "fast", "label": "Fast", "hint": "sparse attention speed-up"},
        {"id": "normal", "label": "Normal", "hint": "no speed-up"}
      ]
    },
    {
      "id": "quality", "label": "Quality", "default": "medium",
      "choices": [
        {"id": "low", "label": "Low", "hint": "4 steps + turbo LoRA"},
        {"id": "medium", "label": "Medium", "hint": "20 steps, full model"},
        {"id": "high", "label": "High", "hint": "40 steps, full model"}
      ]
    }
  ],
  "rules": [
    {"when": {"quality": "low"}, "set": {"108.value": false, "113.value": 4, "109.value": false}},
    {"when": {"quality": "low", "mode": "fast"}, "set": {"109.value": true}},
    {"when": {"quality": "medium"}, "set": {"108.value": true, "105.value": 20, "109.value": false}},
    {"when": {"quality": "high"}, "set": {"108.value": true, "105.value": 40, "109.value": false}},
    {
      "when": {"quality": ["medium", "high"], "mode": "fast"},
      "add": {
        "400": {
          "class_type": "BlockSparseAttention",
          "inputs": {
            "model": ["1", 0], "selection": "sol-attn", "selection.tau": 1.3, "start_percent": 0.2,
            "end_percent": 1.0, "dense_blocks": "", "min_tokens": 12288, "extra_tokens": 256,
            "sink_conditioning": "exact_kv_and_rows", "verbose": false
          },
          "_meta": {"title": "Sol-Attn sparse attention"}
        }
      },
      "set": {"27.on_true": ["400", 0]}
    }
  ],
  "confirm": [
    {
      "when": {"quality": "high"},
      "message": "High quality runs 40 full steps and takes about twice as long as medium.",
      "alt": {"label": "Use medium instead", "set": {"quality": "medium"}}
    },
    {
      "when": {"duration": 15},
      "message": "A single 15 s clip overflows the 32 GB of GPU memory and gets very slow. Three chained 5 s clips are far quicker and drift less.",
      "alt": {"label": "Make 3 chained 5 s clips instead", "set": {"duration": 5, "clips": 3}}
    }
  ],
  "estimate": {
    "key": ["mode", "quality"],
    "base_pixels": 1032192,
    "table": {
      "fast/low": {"5": [0.9, true], "10": [2.0, true], "15": [18, true]},
      "fast/medium": {"5": [2.3, true], "10": [6.1, true], "15": [25, false]},
      "fast/high": {"5": [4.3, false], "10": [14, false]},
      "normal/low": {"5": [1.2, true], "10": [3.2, true], "15": [25, false]},
      "normal/medium": {"5": [4.3, true], "10": [13.8, true], "15": [90, false]},
      "normal/high": {"5": [8.3, true], "10": [27.0, true], "15": [180, false]}
    }
  },
  "hints": [
    "Low quality is a draft: expect smudges, soft backgrounds and frozen mouths. Use medium or high for finals.",
    "Lip sync needs a voice track, with one speaker per clip.",
    "Use a background image or a first frame to keep the same location.",
    "Use reference images of at least 1024 px, with no watermarks or text. A watermark can get copied into the video.",
    "Best results come from 5-6 s clips, one action each, and a locked camera.",
    "In the prompt say \"the main character\", \"the outfit\", \"the background\". The workflow numbers the references for you."
  ]
}
