":"output height (exact)","properties":{"Node name for S&R":"ComfyMathExpression"},"widgets_values":["round(b * c / min(a, b) / 2) * 2"],"widgets_values_named":{"expression":"round(b * c / min(a, b) / 2) * 2"}},{"id":130,"type":"PrimitiveBoolean","pos":[0,1134],"size":[270,58],"flags":{},"order":14,"mode":0,"inputs":[{"localized_name":"value","name":"value","type":"BOOLEAN","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"BOOLEAN","name":"BOOLEAN","type":"BOOLEAN","links":[102]}],"title":"USE VOICE TRACK (on = lips follow the audio file below)","properties":{"Node name for S&R":"PrimitiveBoolean"},"widgets_values":[false],"widgets_values_named":{"value":false}},{"id":131,"type":"MarkdownNote","pos":[-620,0],"size":[560,820],"flags":{},"order":15,"mode":0,"inputs":[],"outputs":[],"properties":{},"widgets_values":["# ai_influencer (quality setup, no upscaler)\n\n**Defaults**: full model (TURBO off), 40 steps, 768p (H3's native size), 10 s, seed fixed.\n\n**Your image** is resized (lanczos) to the video size and used as the first frame. No SeedVR2, no upscaler in this workflow. Use a sharp image: a small or blurry one gives a soft video. For talking scenes, crop the image so faces are large.\n\n**Voice track (optional)**: turn on USE VOICE TRACK and pick an audio or video file with the dialogue. The mouths then follow that audio.\n\n**Dialogue prompt tips**\n- Start with `<Picture 1>`, name each speaker by something visible.\n- Use a timeline: [0s-4.5s] who speaks + the line in quotes; [4.5s-10s] the next speaker.\n- Say what the listener does: \"stays silent with his lips closed, nodding\".\n- Add \"realistic lip articulation, no exaggerated mouth opening\".\n\nBackups: **ai_influencer_seedvr2_backup** (with SeedVR2 image restore), **ai_influencer_backup** (the older original)."],"widgets_values_named":{"text":"# ai_influencer (quality setup, no upscaler)\n\n**Defaults**: full model (TURBO off), 40 steps, 768p (H3's native size), 10 s, seed fixed.\n\n**Your image** is resized (lanczos) to the video size and used as the first frame. No SeedVR2, no upscaler in this workflow. Use a sharp image: a small or blurry one gives a soft video. For talking scenes, crop the image so faces are large.\n\n**Voice track (optional)**: turn on USE VOICE TRACK and pick an audio or video file with the dialogue. The mouths then follow that audio.\n\n**Dialogue prompt tips**\n- Start with `<Picture 1>`, name each speaker by something visible.\n- Use a timeline: [0s-4.5s] who speaks + the line in quotes; [4.5s-10s] the next speaker.\n- Say what the listener does: \"stays silent with his lips closed, nodding\".\n- Add \"realistic lip articulation, no exaggerated mouth opening\".\n\nBackups: **ai_influencer_seedvr2_backup** (with SeedVR2 image restore), **ai_influencer_backup** (the older original)."},"color":"#432","bgcolor":"#653"}],"links":[[60,60,0,24,0,"IMAGE"],[61,30,0,26,0,"MODEL"],[62,108,0,27,2,"BOOLEAN"],[63,30,0,27,0,"MODEL"],[64,26,0,27,1,"MODEL"],[65,108,0,28,2,"BOOLEAN"],[66,105,0,28,0,"INT"],[67,113,0,28,1,"INT"],[68,31,0,34,0,"CLIP"],[69,32,0,34,1,"VAE"],[70,60,0,34,2,"IMAGE"],[71,100,0,34,4,"STRING"],[72,120,1,34,5,"INT"],[73,121,1,34,6,"INT"],[74,110,1,34,7,"INT"],[75,106,0,35,0,"INT"],[76,27,0,37,0,"MODEL"],[77,28,0,37,2,"INT"],[78,27,0,38,0,"MODEL"],[79,72,0,38,1,"CONDITIONING"],[80,35,0,39,0,"NOISE"],[81,38,0,39,1,"GUIDER"],[82,36,0,39,2,"SAMPLER"],[83,37,0,39,3,"SIGMAS"],[84,34,1,39,4,"LATENT"],[85,39,0,40,0,"LATENT"],[86,32,0,40,1,"VAE"],[87,39,0,41,0,"LATENT"],[88,33,0,41,1,"VAE"],[89,57,0,54,0,"IMAGE"],[90,41,0,54,1,"AUDIO"],[91,54,0,55,0,"VIDEO"],[92,40,0,57,0,"IMAGE"],[93,122,1,57,2,"INT"],[94,123,1,57,3,"INT"],[95,1,0,60,0,"IMAGE"],[96,120,1,60,2,"INT"],[97,121,1,60,3,"INT"],[98,34,0,71,0,"CONDITIONING"],[99,33,0,71,3,"VAE"],[100,34,1,71,1,"LATENT"],[101,70,0,71,5,"AUDIO"],[102,130,0,72,2,"BOOLEAN"],[103,34,0,72,0,"CONDITIONING"],[104,71,0,72,1,"CONDITIONING"],[105,102,0,110,0,"FLOAT"],[106,1,0,114,0,"IMAG